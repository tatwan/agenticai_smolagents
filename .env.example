# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
#
# Never commit .env. It is gitignored.

# ---------------------------------------------------------------------------
# Hugging Face Inference Providers (cloud path)
# ---------------------------------------------------------------------------
# Create a *fine-grained* token at https://huggingface.co/settings/tokens
# Enable the permission: "Make calls to Inference Providers"
# A classic "Read" token is NOT enough.
#
# Free accounts get a small monthly credit (~$0.10 as of 2026), then
# pay-as-you-go. This is not an unlimited free LLM. For a zero-cost path
# use Ollama below.
HF_TOKEN=

# Optional: pin a Hub model id (default is set in course_setup.py)
# COURSE_MODEL_ID=Qwen/Qwen3-Next-80B-A3B-Thinking

# Optional: force a provider instead of auto-routing
# Examples: together, novita, sambanova, fireworks-ai, groq
# COURSE_HF_PROVIDER=

# ---------------------------------------------------------------------------
# Local / zero-cost path (Ollama + LiteLLM)
# ---------------------------------------------------------------------------
# 1. Install Ollama: https://ollama.com
# 2. Pull a coding-capable model, e.g.:
#      ollama pull qwen2.5-coder:7b
# 3. Set:
# COURSE_MODEL_BACKEND=ollama
# COURSE_OLLAMA_MODEL=ollama_chat/qwen2.5-coder:7b
# OLLAMA_API_BASE=http://localhost:11434

# Which backend to use: hf  |  ollama
# If unset: uses hf when HF_TOKEN is present, otherwise ollama.
# COURSE_MODEL_BACKEND=

# ---------------------------------------------------------------------------
# Optional — Module 03 model-swap demo only
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
